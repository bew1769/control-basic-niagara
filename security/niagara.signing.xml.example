<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shape of the profile Niagara 4.15.6 plugin 7.6.22 actually loads
  (java.util.Properties XML). Do not fill in passwords here.
  createProfile / generateCertificate write security/niagara.signing.xml,
  which is gitignored, and a sibling security/niagara.signing.pkcs12.
-->
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
  <comment>Example only. No secrets.</comment>
  <entry key="niagara.signing.profileType">com.tridium.gradle.plugins.signing.profile.RestrictedSigningProfile</entry>
  <entry key="niagara.signing.storetype">PKCS12</entry>
  <entry key="niagara.signing.keyalg">RSA</entry>
  <entry key="niagara.signing.keysize">3072</entry>
</properties>
