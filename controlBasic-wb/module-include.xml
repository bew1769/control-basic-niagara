<!--
  Default view registration. default="true" plus AgentOn.Preference.PREFERRED
  makes this the view Workbench opens on double-click.
  Slot-o-matic wraps this file in a dummy root, so it must not start with an XML declaration.
-->
<types>
  <type class="com.controlbasic.ui.BControlBasicEditor" name="ControlBasicEditor">
    <agent default="true">
      <on type="controlBasic:ControlBasicBlock"/>
    </agent>
  </type>
</types>
